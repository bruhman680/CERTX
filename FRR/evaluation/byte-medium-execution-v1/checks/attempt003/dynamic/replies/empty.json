44000124605, "stderr": "", "stdout": "{\"material\": \"regular\", \"bytes\": 0, \"before_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"after_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"}\n"}, "kind": "python", "parent_event_sha256": "9b6e35385f67a1e99d6e13ad753f2d0374d9f4197b9cd94878dac180ca9f5cd7", "raw_text": null, "receipt": {"boundary": null, "exit_code": 0, "seconds": 0.030165344000124605, "stderr": "", "stdout": "{\"material\": \"regular\", \"bytes\": 0, \"before_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\", \"after_sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"}\n"}, "source": "import os,stat,json,hashlib\np='field.bin'\ntry:\n    s=os.lstat(p)\nexcept FileNotFoundError:\n    print(json.dumps({'material':'absent'}))\nelse:\n    if not stat.S_ISREG(s.st_mode):\n        print(json.dumps({'material':'nonregular','changed':False}))\n    else:\n        fd=os.open(p,os.O_RDWR|os.O_NOFOLLOW)\n        try:\n            raw=b''\n            while True:\n                chunk=os.read(fd,65536)\n                if not chunk:break\n                raw+=chunk\n            out=bytearray(raw)\n            n=len(raw)//2\n            if 'changing'=='changing':\n                for i in range(n):\n                    out[2*i]=raw[2*i+1]\n                    out[2*i+1]=raw[2*i]^raw[2*((i-1)%n)+1]^raw[2*((i+1)%n)+1]\n                os.lseek(fd,0,0)\n                view=memoryview(out)\n                while view:\n                    count=os.write(fd,view)\n                    if not count:raise OSError('zero-length write')\n                    view=view[count:]\n                os.fsync(fd)\n            print(json.dumps({'material':'regular','bytes':len(raw),'before_sha256':hashlib.sha256(raw).hexdigest(),'after_sha256':hashlib.sha256(out).hexdigest()}))\n        finally:\n            os.close(fd)\n", "step": 9}, "raw_text": "```python\nopen('field.bin','wb').write(b'')\n```", "reply_id": "empty", "text_sha256": "e554037ac73a60d37f4a53b14b240bd7efb8f99aa719d05c8f0ac014c7463457"}
