out": "{\"material\": \"regular\", \"bytes\": 62, \"before_sha256\": \"9239bfabee814f8d2ea205793b731e3a6f48c7549c8eab7fe612876dfc8b04a4\", \"after_sha256\": \"234caefaa647d42a802c7e026c24d888c8cd4ed8032ddaa4eebaff8856a46bf4\"}\n"}, "kind": "python", "parent_event_sha256": "e08eae5aa5b9acb99d52f7a9a89420d2b21a50bbebe6a1ddb74e54b8a0e69026", "raw_text": null, "receipt": {"boundary": null, "exit_code": 0, "seconds": 0.029638654999871505, "stderr": "", "stdout": "{\"material\": \"regular\", \"bytes\": 62, \"before_sha256\": \"9239bfabee814f8d2ea205793b731e3a6f48c7549c8eab7fe612876dfc8b04a4\", \"after_sha256\": \"234caefaa647d42a802c7e026c24d888c8cd4ed8032ddaa4eebaff8856a46bf4\"}\n"}, "source": "import os,stat,json,hashlib\np='field.bin'\ntry:\n    s=os.lstat(p)\nexcept FileNotFoundError:\n    print(json.dumps({'material':'absent'}))\nelse:\n    if not stat.S_ISREG(s.st_mode):\n        print(json.dumps({'material':'nonregular','changed':False}))\n    else:\n        fd=os.open(p,os.O_RDWR|os.O_NOFOLLOW)\n        try:\n            raw=b''\n            while True:\n                chunk=os.read(fd,65536)\n                if not chunk:break\n                raw+=chunk\n            out=bytearray(raw)\n            n=len(raw)//2\n            if 'changing'=='changing':\n                for i in range(n):\n                    out[2*i]=raw[2*i+1]\n                    out[2*i+1]=raw[2*i]^raw[2*((i-1)%n)+1]^raw[2*((i+1)%n)+1]\n                os.lseek(fd,0,0)\n                view=memoryview(out)\n                while view:\n                    count=os.write(fd,view)\n                    if not count:raise OSError('zero-length write')\n                    view=view[count:]\n                os.fsync(fd)\n            print(json.dumps({'material':'regular','bytes':len(raw),'before_sha256':hashlib.sha256(raw).hexdigest(),'after_sha256':hashlib.sha256(out).hexdigest()}))\n        finally:\n            os.close(fd)\n", "step": 4}, "raw_text": "```sh\nchmod 644 field.bin\n```", "reply_id": "restore_permission", "text_sha256": "dc29dd8dd0a3a458926d383c071eafd8f00c15b460d30084e7f1f7504e912975"}
